{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BLENDED_WORKS_ADMIN_EMAILS",
    "CLERK_SECRET_KEY",
    "CODE_AI_GITHUB_REPOSITORIES",
    "CODE_AI_MODEL",
    "CODE_AI_OWNER_EMAIL",
    "GITHUB_ACCESS_TOKEN",
    "LOCATION_UPDATE_SECRET",
    "NEXT_PUBLIC_SITE_URL",
    "OPENAI_API_SECRET_KEY",
    "SANITY_API_WRITE_TOKEN",
    "SANITY_EDITOR_API_KEY",
    "SANITY_READ_WRITE_DEVELOPER_API",
    "LEGAL_AI_MODEL",
    "LEGAL_AI_OWNER_EMAIL",
    "OPENAI_API_KEY",
    "OUGM_AI_MODEL",
    "OUGM_STAFF_EMAILS",
    "OUGM_TRANSCRIPTION_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

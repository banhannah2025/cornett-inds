{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BLENDED_WORKS_ADMIN_EMAILS",
    "CLERK_SECRET_KEY",
    "LOCATION_GEOCODER_URL",
    "LOCATION_GEOCODER_USER_AGENT",
    "LOCATION_TIME_ZONE",
    "LOCATION_UPDATE_SECRET",
    "SANITY_API_WRITE_TOKEN",
    "SANITY_READ_WRITE_DEVELOPER_API"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
